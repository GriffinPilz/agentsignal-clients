{
  "name": "@agentsignal/cli",
  "version": "0.1.0",
  "description": "Send AgentSignal notifications from a terminal.",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "bin": {
    "agentsignal": "./dist/index.js"
  },
